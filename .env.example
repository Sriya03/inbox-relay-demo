# Copy to .env and fill in from the Meta credits dashboard. Never commit .env.
# Base URL for the Meta Model API (if the dashboard shows a full endpoint
# path ending in chat/completions, put that whole path here instead).
META_API_BASE_URL=https://api.example.com/v1
META_API_KEY=your-key-here
# Comma-separated model IDs to benchmark, as listed on the dashboard.
META_MODELS=model-id-1,model-id-2
